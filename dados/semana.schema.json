{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vixeee/semana.schema.json",
  "title": "semana.json — conteúdo semanal do Vixeee Que Barato",
  "type": "object",
  "required": ["semana", "gerado_em", "produtos"],
  "additionalProperties": false,
  "patternProperties": { "^_": true },
  "properties": {
    "semana": {
      "type": "string",
      "description": "Semana ISO, ex.: 2026-W34",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "gerado_em": {
      "type": "string",
      "description": "Data/hora ISO-8601 com offset, ex.: 2026-08-19T14:00:00-03:00"
    },
    "produtos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/produto" }
    }
  },
  "$defs": {
    "produto": {
      "type": "object",
      "required": ["dia", "dia_semana", "nome", "affiliate_link", "tem_video"],
      "additionalProperties": false,
      "patternProperties": { "^_": true },
      "properties": {
        "dia": { "type": "integer", "minimum": 1, "maximum": 7 },
        "dia_semana": {
          "type": "string",
          "enum": ["segunda", "terca", "quarta", "quinta", "sexta", "sabado", "domingo"]
        },
        "item_id": { "type": ["string", "null"] },
        "shop_id": { "type": ["string", "null"] },
        "nome": { "type": "string", "minLength": 1 },
        "categoria": { "type": ["string", "null"] },
        "preco": { "type": ["number", "null"], "minimum": 0 },
        "preco_original": { "type": ["number", "null"], "minimum": 0 },
        "desconto_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "comissao_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "vendas": { "type": ["string", "null"] },
        "avaliacao": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "image_url": {
          "type": ["string", "null"],
          "description": "URL pública da imagem do produto (CDN da Shopee)"
        },
        "video_url": {
          "type": ["string", "null"],
          "description": "URL pública do mp4 na CDN — quem baixa é o GitHub Actions, NÃO um arquivo local"
        },
        "tem_video": {
          "type": "boolean",
          "description": "false → a fábrica gera arte estática em vez de vídeo"
        },
        "affiliate_link": { "type": "string", "minLength": 1 },
        "legenda_ig": { "type": ["string", "null"] },
        "legenda_tg": { "type": ["string", "null"] },
        "hashtags": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    }
  }
}
